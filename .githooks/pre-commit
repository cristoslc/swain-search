#!/usr/bin/env bash
# pre-commit — Run swain-search evals before commit
# Triggers on changes to skills/swain-search/SKILL.md, skills/swain-search/references/, skills/swain-search/scripts/

CHANGED=$(git diff --cached --name-only | grep -E '^(skills/swain-search/SKILL\.md|skills/swain-search/references/|skills/swain-search/scripts/)' || true)
if [ -z "$CHANGED" ]; then
    exit 0
fi

echo "=== swain-search: Running evals ==="
cd "$(git rev-parse --show-toplevel)"
FAILS=0

# Tier 1: Script-level tests (fast, <1s each)
echo "--- Script tests ---"
for f in tests/test-*.sh; do
    base=$(basename "$f")
    if echo "$base" | grep -q "^test-deep-"; then
        # Skip deep behavioral tests in pre-commit (need API credits)
        continue
    fi
    if bash "$f" > /dev/null 2>&1; then
        echo "  PASS: $base"
    else
        FAILS=$((FAILS + 1))
        echo "  FAIL: $base"
        bash "$f" 2>&1 | tail -5
    fi
done

# Tier 2: Ollama evals (fast, ~30s total, ~$0)
echo "--- Ollama evals ---"
for suite in mode-detection trove-creation prior-art graceful-degradation adversarial; do
    RESULTS=$(npx promptfoo@latest eval -c "skills/swain-search/evals/suites/$suite.yaml" --no-cache 2>&1)
    if echo "$RESULTS" | grep -q "100%)"; then
        echo "  PASS: $suite"
    else
        FAILS=$((FAILS + 1))
        echo "  FAIL: $suite"
        echo "$RESULTS" | grep "failed"
    fi
done

if [ "$FAILS" -gt 0 ]; then
    echo "FAIL: $FAILS suite(s) failed. Run 'npx promptfoo view' to inspect."
    exit 1
fi

echo "PASS: All evals passed."
exit 0